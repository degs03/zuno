{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Plugins that only exist on desktop (autostart, self-update).",
  "platforms": [
    "windows",
    "macOS",
    "linux"
  ],
  "windows": [
    "main",
    "mini-player"
  ],
  "permissions": [
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "updater:default"
  ],
  "remote": {
    "urls": [
      "http://localhost:*/*"
    ]
  }
}
