<?xml version="1.0" encoding="utf-8"?>
<!-- 4x3: cover and track on top, "up next", a timed progress bar, and the full transport. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/widget_art_description"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/app_name"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_idle"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_next_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#80FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_elapsed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#80FFFFFF"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#80FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_shuffle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="@string/widget_shuffle"
            android:padding="9dp"
            android:src="@drawable/widget_ic_shuffle" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_prev"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="@string/widget_previous"
            android:padding="8dp"
            android:src="@drawable/widget_ic_prev" />

        <FrameLayout
            android:id="@+id/widget_play"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="@string/widget_play">

            <ImageView
                android:id="@+id/widget_play_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_circle" />

            <ImageView
                android:id="@+id/widget_play_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="13dp"
                android:src="@drawable/widget_ic_play" />
        </FrameLayout>

        <ImageView
            android:id="@+id/widget_next"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="@string/widget_next"
            android:padding="8dp"
            android:src="@drawable/widget_ic_next" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_repeat"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="@string/widget_repeat"
            android:padding="9dp"
            android:src="@drawable/widget_ic_repeat" />

        <ImageView
            android:id="@+id/widget_like"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="@string/widget_like"
            android:padding="9dp"
            android:src="@drawable/widget_ic_heart" />
    </LinearLayout>
</LinearLayout>
