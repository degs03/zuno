{
  "name": "zuno",
  "private": true,
  "version": "1.8.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/run-checks.mjs",
    "lint": "eslint src --max-warnings 0",
    "verify": "npm run typecheck && npm run lint && npm run check",
    "tauri": "tauri",
    "tv:dev": "vite --config tv/vite.config.ts",
    "tv:typecheck": "tsc -p tv/tsconfig.json",
    "tv:build": "tsc -p tv/tsconfig.json && vite build --config tv/vite.config.ts && es-check es5 \"tv/dist/**/*.js\"",
    "tv:package": "npm run tv:build && ares-package tv/dist -o tv/release"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@solar-icons/react": "^2.6.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "bgutils-js": "^4.0.3",
    "clsx": "^2.1.1",
    "googlevideo": "^5.0.1",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-legacy": "^8.2.4",
    "@vitejs/plugin-react": "^6.3.0",
    "@webos-tools/cli": "^3.2.6",
    "es-check": "^9.9.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "preact": "^11.2.0",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.8"
  }
}
