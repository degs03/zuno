{
  "name": "zuno",
  "private": true,
  "version": "1.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/run-checks.mjs",
    "lint": "eslint src --max-warnings 0",
    "verify": "npm run typecheck && npm run lint && npm run check",
    "tauri": "tauri",
    "tv:dev": "vite --config tv/vite.config.ts",
    "tv:typecheck": "tsc -p tv/tsconfig.json",
    "tv:build": "tsc -p tv/tsconfig.json && vite build --config tv/vite.config.ts && es-check es5 \"tv/dist/**/*.js\"",
    "tv:package": "npm run tv:build && ares-package tv/dist -o tv/release"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@solar-icons/react": "^2.0.0-beta.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "bgutils-js": "^4.0.2",
    "clsx": "^2.1.1",
    "googlevideo": "^4.1.1",
    "motion": "^12.42.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "youtubei.js": "^17.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react": "^4.6.0",
    "@webos-tools/cli": "^3.2.6",
    "es-check": "^9.9.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
